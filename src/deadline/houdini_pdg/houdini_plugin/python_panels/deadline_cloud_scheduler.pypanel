<pythonPanelDocument>
  <!-- The Deadline Cloud Scheduler node's Parameters pane. The panel itself is the
 deadline.houdini_pdg.houdini.panel module; this script only loads it. -->
  <interface name="deadline_cloud_scheduler" label="Deadline Cloud Scheduler" icon="" showNetworkNavigationBar="false" help_url="">
    <script><![CDATA[
import hou

try:
    from deadline.houdini_pdg.houdini.panel import create_panel
    load_error = ""
except Exception as error:
    create_panel = None
    load_error = f"The Deadline Cloud farm and queue panel didn't load: {error}"

# The parameter editor this pane shows, so a new selection goes to it.
editor = None


def onCreateInterface():
    global editor
    node = kwargs["paneTab"].currentNode()
    if create_panel is not None:
        widget, editor = create_panel(node)
        return widget
    # Without the panel module, show the node's parms under one error line.
    from hutil.Qt import QtWidgets

    widget = QtWidgets.QWidget()
    layout = QtWidgets.QVBoxLayout(widget)
    layout.addWidget(QtWidgets.QLabel(load_error))
    editor = hou.qt.ParmDialog(node)
    layout.addWidget(editor)
    return widget


def onNodePathChanged(node):
    # Only a scheduler node's parms belong under the farm and queue lists.
    if editor is None or node is None or node.type().name() != "deadlinecloudscheduler":
        return
    editor.setNode(node)
]]></script>
    <showInParametersPane optype="Top/deadlinecloudscheduler"/>
    <help><![CDATA[]]></help>
  </interface>
</pythonPanelDocument>
